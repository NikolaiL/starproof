{
  "name": "starproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space exploration demo for certified Trust M actions via wedgie-actions.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "pretest": "npm run build",
    "build": "node tools/build.js",
    "prestart": "npm run build",
    "contracts:build": "forge build && node tools/sync-airdrop.js && node tools/sync-monsters.js",
    "test:contracts": "forge test",
    "test:fork": "node --test --test-concurrency=1 test/airdrop.test.js test/token-fork.test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaiL/starproof.git"
  },
  "homepage": "https://github.com/NikolaiL/starproof#readme",
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "three": "^0.187.0",
    "viem": "2.57.16",
    "wedgie-actions": "https://codeload.github.com/NikolaiL/wedgie-actions/tar.gz/0fcadb3a79c60b64ab4f9b5a63fb67796b81d4a4"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "esbuild": "^0.28.2",
    "starproof-device": "https://codeload.github.com/NikolaiL/wedgie-starproof/tar.gz/80bdad6b3d6379860bdc7c2f121fe1d7931fe07e"
  }
}
