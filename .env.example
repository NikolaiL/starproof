# Production origin; local development can omit this.
APP_ORIGIN=https://starproof-wedgie.vercel.app
# Production sessions and durable relay jobs use the existing private Redis integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dedicated Base RPC URL, kept server-side. Do not commit real credentials.
AIRDROP_RPC_URL=
# Set after deploying StarproofAirdrop with the confirmed administrator and proof issuer.
AIRDROP_CONTRACT=
# A dedicated server-side account: authorizes the funded drop and pays relay gas.
# Never put a personal wallet key or a Wedgie key here. Never send keys in chat.
AIRDROP_ISSUER_PRIVATE_KEY=
# Base monster NFTs. Defaults to the existing airdrop RPC and issuer; no new key is needed.
MONSTERS_CONTRACT=
# Optional overrides for a dedicated future deployment.
MONSTERS_RPC_URL=
MONSTERS_ISSUER_PRIVATE_KEY=
